{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pos034-license",
  "account_id": "95b931194e93e924460507e04c746e46",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-22",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pos034-license",
      // Filled in after `wrangler d1 create pos034-license`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare Access protects /admin. Until both are set the dashboard stays
  // locked. The signing key is a secret: `wrangler secret put LICENSE_PRIVATE_KEY`.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },

  "observability": { "enabled": true }
}
