{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pos034-license",
  "account_id": "95b931194e93e924460507e04c746e46",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-22",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pos034-license",
      // Filled in after `wrangler d1 create pos034-license`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Encrypted nightly backups (ciphertext only — the server cannot read them).
  // Workers KV: on the free plan, no card needed.
  "kv_namespaces": [
    {
      "binding": "BACKUPS",
      // Filled in after `wrangler kv namespace create pos034-backups`.
      "id": "00000000000000000000000000000000"
    }
  ],

  // /admin: Cloudflare Access when both of these are set, otherwise the
  // ADMIN_PASSWORD secret; with neither, the dashboard stays locked.
  // Secrets: `wrangler secret put LICENSE_PRIVATE_KEY` and `ADMIN_PASSWORD`.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },

  "observability": { "enabled": true }
}
